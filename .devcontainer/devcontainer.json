{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "mise trust && mise install && mise exec -- bash scripts/setup_project",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    22111,
    22112
  ],
  "runArgs": [
    "--dns=1.1.1.1",
    "--dns=1.0.0.1"
  ]
}
